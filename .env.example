# Copie para .env e preencha. Nunca commite o .env nem o JSON da conta de serviço.

# --- Servidor ---
PORT=3000
DATA_PATH=./data/clinic.sqlite

# --- Clínica (padrão: seg–sex, 08:00–18:00, sessões de 50 min, America/Sao_Paulo) ---
CLINIC_NAME=Consultório de Fisioterapia
CLINIC_TIMEZONE=America/Sao_Paulo
CLINIC_OPEN=08:00
CLINIC_CLOSE=18:00
CLINIC_SESSION_MINUTES=50
CLINIC_DAYS_AHEAD=7
# 1 = segunda ... 7 = domingo
CLINIC_WEEKDAYS=1,2,3,4,5
# Antecedência mínima para oferecer um horário, em minutos.
CLINIC_MIN_NOTICE_MINUTES=0

# --- WhatsApp Cloud API (oficial) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Segredo do app Meta. Se definido, o POST /webhook exige X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0

# --- Google Calendar: conta de serviço (caminho padrão) ---
# Caminho do JSON baixado no Google Cloud. Não commite esse arquivo.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
# ID da agenda da clínica (Configurações da agenda → Integrar agenda). Não use "primary".
GOOGLE_CALENDAR_ID=

# --- Google Calendar: OAuth (alternativa) ---
# Usado só se GOOGLE_SERVICE_ACCOUNT_JSON estiver vazio.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Opcional. Se definido, GET /api/calendar/availability exige Authorization: Bearer <token>.
# INTERNAL_CHECK_TOKEN=
