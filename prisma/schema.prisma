generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  createdAt    DateTime       @default(now())
  sports       UserSport[]
  availability Availability[]
  squadsCreated Squad[]       @relation("SquadsCreated")
  memberships  SquadMember[]
}

model UserSport {
  userId String
  sport  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sport])
}

model Availability {
  id        String @id @default(cuid())
  userId    String
  dayOfWeek Int
  startMin  Int
  endMin    Int
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Squad {
  id                 String        @id @default(cuid())
  kind               String
  status             String
  creatorId          String
  createdAt          DateTime      @default(now())
  creator            User          @relation("SquadsCreated", fields: [creatorId], references: [id])
  members            SquadMember[]
  madeChallenges     Challenge[]   @relation("ChallengerSquad")
  receivedChallenges Challenge[]   @relation("ChallengedSquad")

  @@index([creatorId])
  @@index([status])
}

model SquadMember {
  id          String    @id @default(cuid())
  squadId     String
  userId      String
  status      String
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  squad       Squad     @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([userId, status])
}

model Challenge {
  id                String    @id @default(cuid())
  challengerSquadId String
  challengedSquadId String
  sport             String
  court             String
  startAt           DateTime
  endAt             DateTime
  status            String
  awaiting          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  challengerSquad   Squad     @relation("ChallengerSquad", fields: [challengerSquadId], references: [id])
  challengedSquad   Squad     @relation("ChallengedSquad", fields: [challengedSquadId], references: [id])
  proposals         Proposal[]

  @@index([status])
  @@index([challengerSquadId])
  @@index([challengedSquadId])
}

model Proposal {
  id          String    @id @default(cuid())
  challengeId String
  squadId     String
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}
